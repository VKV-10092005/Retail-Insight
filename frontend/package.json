        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.5",
        "recharts": "^2.15.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "vite": "^6.0.3"
    }
