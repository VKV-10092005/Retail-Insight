{
    "name": "retail-ai-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 0.0.0.0",
        "build": "vite build",
        "preview": "vite preview --host 0.0.0.0",
        "test:e2e": "playwright test",
        "preview:ui1": "node ui1-server.mjs --serve-ui1",
        "build:ui1": "vite build --config vite.ui1.config.js",
