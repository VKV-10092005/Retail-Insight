# Local development uses the Vite proxy. Set to the deployed backend URL + /api/v1 on Vercel.
VITE_API_URL=/api/v1
# Backward-compatible alias; VITE_API_URL takes precedence.
VITE_API_BASE_URL=/api/v1
VITE_AUTH_BASE_URL=/api/v1/auth
# Google OAuth 2.0 Client ID for Google Identity Services button
VITE_GOOGLE_CLIENT_ID=
# Business screens remain explicitly marked demonstrations until later sprints.
VITE_DATA_MODE=mock
