# =================================================================
# RETAIL INSIGHT - SERVER PRODUCTION CONFIGURATION TEMPLATE
# =================================================================

# Server Environment & Port
NODE_ENV=production
PORT=3000
TRUST_PROXY=1

# MySQL Database Configuration
# Supports both MYSQL_* and DB_* aliases for standard cloud deploy (VPS/Docker/Render/Railway)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=retail_app
MYSQL_PASSWORD=your_secure_mysql_password_here
MYSQL_DATABASE=retail_app
MYSQL_SSL=false
# Optional CA certificate in PEM format for providers requiring a custom CA.
MYSQL_SSL_CA=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=retail_app
DB_PASSWORD=your_secure_mysql_password_here
DB_NAME=retail_app

# Security & Authentication
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
FRONTEND_URL=http://localhost:5173
# Optional additional allowed origin(s), comma-separated.
CORS_ORIGIN=

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=

# Gmail SMTP Configuration for 2-step OTP Verification
# Use Gmail address and 16-character App Password (not your personal Google account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
SMTP_FROM="Retail Insight <your_email@gmail.com>"
# HTTPS email API (recommended on Render Free, which blocks SMTP ports 465/587).
RESEND_API_KEY=
# Verified sender identity, e.g. "Retail Insight <no-reply@your-verified-domain.com>".
EMAIL_FROM=
# Never expose OTP unless explicitly opted in during local development (0 for production).
ALLOW_DEV_OTP=0

# Research / Analytics Database Connection (Read-only user)
RESEARCH_MYSQL_HOST=127.0.0.1
RESEARCH_MYSQL_PORT=3306
RESEARCH_MYSQL_USER=research_reader
RESEARCH_MYSQL_PASSWORD=your_research_password_here

# FastAPI AI Service Configuration (Internal service)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=your_ai_service_token_at_least_32_chars_long

# Google Gemini API Key for Smart Retail AI Assistant
GEMINI_API_KEY=

# High-speed Groq API Key (Optional fallback: llama-3.3-70b-versatile)
GROQ_API_KEY=

# Optional premium Vietnamese female TTS (Azure Cognitive Speech)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=vi-VN-HoaiMyNeural
